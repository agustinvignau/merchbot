# --- Gemini API ---
# Obtener en: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=tu_api_key_de_gemini
GEMINI_MODEL=gemini-2.5-flash

# --- Telegram Bot (opcional: solo para `merchbot telegram`) ---
# Crear bot con @BotFather en Telegram
TELEGRAM_BOT_TOKEN=tu_token_de_telegram

# IDs de usuarios autorizados a usar el bot, separados por coma.
# SIN ESTO, CUALQUIERA QUE ENCUENTRE EL BOT PUEDE VER TU STOCK Y CLIENTES.
# Para obtener tu ID: arrancá el bot, hablale por privado y escribí /whoami
# Ejemplo: TELEGRAM_ALLOWED_USER_IDS=123456789,987654321
# Si lo dejás vacío, el bot funciona en MODO ABIERTO (solo para desarrollo).
TELEGRAM_ALLOWED_USER_IDS=

# Anti-spam para usuarios NO autorizados:
# Cuántos rechazos respondemos antes de silenciar (sliding window).
# Los usuarios AUTORIZADOS no tienen rate limit.
UNAUTH_MAX_ATTEMPTS=3
UNAUTH_WINDOW_MINUTES=10

# --- Origen de los datos ---
# auto   = Google Sheets si hay SHEETS_ID, si no la planilla de demo
# sheets = siempre Google Sheets
# demo   = planilla de ejemplo data/Stock_Merchandising_Demo.xlsx (sin internet ni Sheets)
DATA_SOURCE=auto

# --- Google Sheets (fuente de verdad del stock) ---
# ID del Sheets compartido como "Cualquiera con el enlace - Lector"
# En la URL: docs.google.com/spreadsheets/d/{ESTE_ES_EL_ID}/edit
# Dejalo vacío para usar los datos de demo.
SHEETS_ID=
SHEETS_STOCK_TAB=Stock
SHEETS_PEDIDOS_TAB=Pedidos

# Cada cuántos minutos sincronizar automáticamente (0 = solo sync manual con /sync)
SYNC_INTERVAL_MIN=15

# --- Base de datos ---
DATABASE_URL=sqlite:///./data/merchbot.db

# --- RAG de políticas ---
# Documento con plazos, cambios, talles, etc. Después de editarlo: merchbot indexar-politicas
# POLITICAS_PATH=/ruta/a/otras-politicas.md   (por defecto: data/politicas.md)
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMENSIONES=768
RAG_TOP_K=3
# Similitud mínima (0 a 1) para usar un fragmento; más alto = más estricto
RAG_MIN_SCORE=0.55

# --- Horario de atención humana ---
# Fuera de este horario el asistente responde igual y lo aclara.
TIMEZONE=America/Argentina/Buenos_Aires
ATENCION_DESDE=09:00
ATENCION_HASTA=18:00
# Días hábiles: 0 = lunes ... 6 = domingo
ATENCION_DIAS=0,1,2,3,4

# --- Web ---
# 127.0.0.1 = solo esta máquina. Docker lo pisa con 0.0.0.0 (ver docker-compose.yml).
WEB_HOST=127.0.0.1
WEB_PORT=8000

# --- Panel admin (/admin) ---
# Clave para entrar al panel de métricas. Vacía = panel deshabilitado.
# Usá una clave larga y propia, por ejemplo: python -c "import secrets; print(secrets.token_urlsafe(24))"
ADMIN_KEY=

# --- App ---
LOG_LEVEL=INFO
APP_ENV=development
